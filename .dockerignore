# Files (kept out of the Go build context; the image holds only the
# tupay binary (+ VERSION, empty /data) — secrets are injected at run
# time, never baked in)
.dockerignore
.editorconfig
.gitignore
.env*
Dockerfile
Makefile
LICENSE
**/*.md
**/*_test.go
*.out
*.test
coverage.*
*.db*
*.db-shm
*.db-wal

# Folders
.git/
.github/
.vscode/
build/
dist/
tmp/

# Dev-only tooling (npm/CI scripts): never compiled into the Go binary,
# never needed inside the image.
scripts/

# Frontend: the Go image never serves the MPA source (282M+ node_modules).
# The MPA is built and hosted separately; see webui/ and make webui.check.
webui/

# Local runtime data: dev SQLite DB and local upload storage must never be
# baked into the image. Production gets a fresh volume/mount instead.
data/

# NOTE: no .env variant ever enters the image — the Dockerfile copies only
# the binary and VERSION. Inject config at run time via --env-file / -e /
# secrets.
