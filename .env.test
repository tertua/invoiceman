# Test environment. Tests override these in TestMain and run against
# in-memory SQLite with an in-memory session store (no services needed).
STAGE_STATUS="dev"

SERVER_HOST="0.0.0.0"
SERVER_PORT=5000
SERVER_READ_TIMEOUT=60

JWT_SECRET_KEY="test-secret"
JWT_SECRET_KEY_EXPIRE_MINUTES_COUNT=15
JWT_REFRESH_KEY="test-refresh"
JWT_REFRESH_KEY_EXPIRE_HOURS_COUNT=720

# In-memory SQLite shared across the single test connection.
SQL_DSN=
SQLITE_PATH="file::memory:?cache=shared"

# Empty REDIS_HOST = in-memory session store.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB_NUMBER=0
