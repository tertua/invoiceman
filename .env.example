# Stage status to start server:
#   - "dev", for start server without graceful shutdown
#   - "prod", for start server with graceful shutdown
STAGE_STATUS="dev"

# Application branding (shown in the SPA header, footer, and page title):
APP_NAME="Invoiceman"

# Server settings:
SERVER_HOST="0.0.0.0"
SERVER_PORT=5000
SERVER_READ_TIMEOUT=60

# CORS: comma-separated frontend origin(s) allowed to use cookie sessions
# cross-origin (production). Empty = permissive dev default (vite proxies
# /api same-origin, so this stays empty locally).
# CORS_ORIGINS="https://billing.example.com"

# JWT settings:
JWT_SECRET_KEY="secret"
JWT_SECRET_KEY_EXPIRE_MINUTES_COUNT=15
JWT_REFRESH_KEY="refresh"
JWT_REFRESH_KEY_EXPIRE_HOURS_COUNT=720

# Database settings (following the one-api pattern):
#   - empty SQL_DSN = SQLite file, zero config (dev default, auto-created)
#   - "postgres://..." prefix = PostgreSQL (production)
#   - any other value = startup error (fail fast; MySQL is not supported)
# SQL_DSN=
SQLITE_PATH="./data/invoiceman.db"
# Production example:
#   SQL_DSN=postgres://postgres:password@template-postgres/postgres?sslmode=disable
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_CONNECTIONS=2

# Redis settings (optional):
#   - empty REDIS_HOST = in-memory session store (single instance, dev default)
#   - set REDIS_HOST = shared sessions via Redis (production, multi instance)
#   - rate-limit counters follow the same rule (memory vs Redis)
# REDIS_HOST="template-redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB_NUMBER=0

# Hardening (P0):
# Rate limits are requests/minute (per IP, except gateway which keys by API key).
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_WEBHOOK=60
RATE_LIMIT_GATEWAY=120
# Per-request timeout for AI + gateway intent routes.
AI_TIMEOUT_SECONDS=30

# Observability (P1):
# Structured logs: text in dev, JSON in prod. Level: debug|info|warn|error.
LOG_LEVEL="info"
# Prometheus-compatible scrape endpoint at GET /metrics (hand-rolled, no deps).
METRICS_ENABLED="true"

# Gemini AI (optional):
# AI endpoints return 501 until a key is configured.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# SMTP email (optional in development):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="billing@example.com"
# APP_PUBLIC_URL="http://localhost:5173"

# Central payment relay (multi-gateway: Midtrans today, crypto-ready):
# Register this once in the Midtrans dashboard:
#   {INVOICEMAN_PUBLIC_URL}/api/webhooks/midtrans
# Generic webhooks for current and future providers:
#   {INVOICEMAN_PUBLIC_URL}/api/webhooks/:gateway
# MIDTRANS_SERVER_KEY=""
# MIDTRANS_CLIENT_KEY=""
# MIDTRANS_IS_PROD="false"
# NOWPayments crypto relay (optional, sandbox moves no funds):
# NOWPAYMENTS_API_KEY=""
# NOWPAYMENTS_IPN_SECRET=""
# NOWPAYMENTS_SANDBOX="true"
# Optional override for tests:
# NOWPAYMENTS_BASE_URL=""
# INVOICEMAN_PUBLIC_URL="http://localhost:5000"
# Optional override for tests (Snap endpoint):
# MIDTRANS_SNAP_BASE_URL=""
# Future providers follow the same pattern (e.g. COINPAYMENTS_*):
# each gateway is one package implementing platform/gateway.Gateway.
